# Port the signaling server listens on (Render sets this automatically).
PORT=3001

# Comma-separated origins allowed to open a WebSocket, e.g. https://kasip2p.vercel.app
# Unset accepts any origin (local dev only).
ALLOWED_ORIGINS=

# Set to true behind a reverse proxy (Render) so client IPs come from X-Forwarded-For.
# Devices only discover peers that share their public IP (or a private LAN address).
TRUST_PROXY=false
