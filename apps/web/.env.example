# WebSocket URL of the signaling server (no trailing /ws; the client appends it).
# Optional in dev: defaults to ws://<host serving the page>:3001. Required in production.
# NEXT_PUBLIC_SIGNAL_URL=wss://your-signaling-server.onrender.com

# Dev only: comma-separated LAN hosts allowed to load the dev server (e.g. your laptop's IP).
ALLOWED_DEV_ORIGINS=192.168.1.50

# Optional STUN/TURN servers as a JSON array of RTCIceServer. Unset = LAN-only (no third party sees IPs).
# Anything NEXT_PUBLIC_ is shipped to browsers: use short-lived TURN credentials, not static ones.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]

# Public address of the site, for canonical links, the sitemap and link previews.
# Optional on Vercel (falls back to the production domain).
# NEXT_PUBLIC_SITE_URL=https://kasip2p.vercel.app
