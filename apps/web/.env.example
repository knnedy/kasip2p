# WebSocket URL of the signaling server (no trailing /ws; the client appends it).
# Optional in dev: defaults to ws://<host serving the page>:3001. Required in production.
# NEXT_PUBLIC_SIGNAL_URL=wss://your-signaling-server.onrender.com

# Dev only: comma-separated LAN hosts allowed to load the dev server (e.g. your laptop's IP).
ALLOWED_DEV_ORIGINS=192.168.1.50
